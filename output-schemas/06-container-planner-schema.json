{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Container Architecture Planner Output",
  "description": "Structured output schema for container architecture planning",
  "type": "object",
  "required": ["architecture_overview", "dockerfiles", "compose_config"],
  "properties": {
    "architecture_overview": {
      "type": "object",
      "required": ["services", "image_strategy"],
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "ports": { "type": "array", "items": { "type": "string" } },
              "dependencies": { "type": "array", "items": { "type": "string" } },
              "scaling": { "type": "string" },
              "stateful": { "type": "boolean" }
            }
          }
        },
        "image_strategy": {
          "type": "object",
          "properties": {
            "base_images": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "service": { "type": "string" },
                  "image": { "type": "string" },
                  "justification": { "type": "string" }
                }
              }
            },
            "registry": { "type": "string" },
            "tagging_strategy": { "type": "string" }
          }
        }
      }
    },
    "dockerfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "content"],
        "properties": {
          "service": { "type": "string" },
          "content": { "type": "string", "description": "Complete Dockerfile content" },
          "build_args": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "default": { "type": "string" }
              }
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "purpose": { "type": "string" },
                "estimated_size": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "compose_config": {
      "type": "object",
      "required": ["development"],
      "properties": {
        "development": {
          "type": "string",
          "description": "docker-compose.yml for local development"
        },
        "production": {
          "type": "string",
          "description": "docker-compose.prod.yml or production override"
        }
      }
    },
    "optimization": {
      "type": "object",
      "properties": {
        "image_sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "estimated_size": { "type": "string" }
            }
          }
        },
        "layer_caching_notes": { "type": "string" },
        "build_time_estimate": { "type": "string" }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "hardening_checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": { "type": "string" },
              "implemented": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        },
        "secret_management": { "type": "string" },
        "scanning_recommendations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dockerignore": {
      "type": "string",
      "description": "Recommended .dockerignore file content"
    }
  }
}
