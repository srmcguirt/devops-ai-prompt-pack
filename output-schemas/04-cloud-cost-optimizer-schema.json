{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud Cost Optimizer Output",
  "description": "Structured output schema for cloud cost optimization analysis",
  "type": "object",
  "required": ["cost_summary", "recommendations"],
  "properties": {
    "cost_summary": {
      "type": "object",
      "required": ["total_monthly_spend", "total_identified_savings"],
      "properties": {
        "total_monthly_spend": { "type": "string" },
        "breakdown_by_service": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "monthly_cost", "percentage"],
            "properties": {
              "service": { "type": "string" },
              "monthly_cost": { "type": "string" },
              "percentage": { "type": "number" }
            }
          }
        },
        "total_identified_savings": {
          "type": "object",
          "required": ["monthly_low", "monthly_high"],
          "properties": {
            "monthly_low": { "type": "string" },
            "monthly_high": { "type": "string" },
            "annual_low": { "type": "string" },
            "annual_high": { "type": "string" },
            "percentage_range": { "type": "string" }
          }
        },
        "confidence_level": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"],
          "description": "Based on data availability"
        },
        "unit_economics": {
          "type": "object",
          "properties": {
            "cost_per_user": { "type": "string" },
            "cost_per_request": { "type": "string" },
            "cost_per_transaction": { "type": "string" }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "effort_level", "monthly_savings", "risk", "implementation"],
        "properties": {
          "title": { "type": "string" },
          "effort_level": {
            "type": "string",
            "enum": ["quick_win", "medium", "strategic"],
            "description": "quick_win: <1 day, medium: 1-5 days, strategic: >1 week"
          },
          "monthly_savings": { "type": "string" },
          "annual_savings": { "type": "string" },
          "risk": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          },
          "implementation": {
            "type": "object",
            "required": ["steps"],
            "properties": {
              "steps": {
                "type": "array",
                "items": { "type": "string" }
              },
              "commands": {
                "type": "array",
                "items": { "type": "string" },
                "description": "CLI commands to implement the change"
              },
              "prerequisites": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "trade_offs": { "type": "string", "description": "What you lose by implementing this" },
          "breakeven_period": { "type": "string", "description": "For committed-use recommendations" }
        }
      }
    },
    "implementation_roadmap": {
      "type": "object",
      "properties": {
        "this_week": {
          "type": "array",
          "items": { "type": "string" }
        },
        "this_month": {
          "type": "array",
          "items": { "type": "string" }
        },
        "this_quarter": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "budget_alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "threshold": { "type": "string" },
              "notification_target": { "type": "string" }
            }
          }
        },
        "review_cadence": { "type": "string" },
        "tagging_policy": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required tags for cost allocation"
        }
      }
    }
  }
}
