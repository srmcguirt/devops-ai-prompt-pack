{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident Response Output",
  "description": "Structured output schema for incident response and management",
  "type": "object",
  "required": ["incident_assessment", "immediate_actions", "investigation"],
  "properties": {
    "incident_assessment": {
      "type": "object",
      "required": ["severity", "justification", "impact"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["SEV1", "SEV2", "SEV3", "SEV4"],
          "description": "SEV1: Full outage, SEV2: Major degradation, SEV3: Minor impact, SEV4: No user impact"
        },
        "justification": { "type": "string" },
        "is_security_incident": { "type": "boolean" },
        "impact": {
          "type": "object",
          "required": ["users_affected", "revenue_impact", "data_integrity"],
          "properties": {
            "users_affected": { "type": "string" },
            "revenue_impact": { "type": "string" },
            "data_integrity": { "type": "string" },
            "duration_so_far": { "type": "string" }
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "event"],
        "properties": {
          "time": { "type": "string", "description": "UTC timestamp or relative time" },
          "event": { "type": "string" },
          "source": { "type": "string", "description": "How this was detected (alert, user report, monitoring)" }
        }
      }
    },
    "immediate_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "action", "type"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "action": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["mitigation", "diagnostic", "communication", "escalation"],
            "description": "Type of action"
          },
          "commands": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Specific commands to run"
          },
          "warning": { "type": "string", "description": "Risk or caveat for this action" },
          "rollback_plan": { "type": "string" }
        }
      }
    },
    "investigation": {
      "type": "object",
      "required": ["hypotheses"],
      "properties": {
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "status"],
            "properties": {
              "description": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["INVESTIGATING", "CONFIRMED", "ELIMINATED"]
              },
              "evidence": { "type": "string" },
              "verification_command": { "type": "string" }
            }
          }
        },
        "recent_changes_checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "change_type": { "type": "string" },
              "how_to_check": { "type": "string" },
              "checked": { "type": "boolean" }
            }
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "properties": {
        "internal_update": {
          "type": "string",
          "description": "Slack/Teams status update template"
        },
        "customer_communication": {
          "type": "string",
          "description": "Status page or email template (SEV1/SEV2 only)"
        },
        "next_update_interval": {
          "type": "string",
          "description": "When to send the next status update"
        }
      }
    },
    "post_incident": {
      "type": "object",
      "properties": {
        "postmortem_template": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "root_cause": { "type": "string" },
            "impact_duration": { "type": "string" },
            "action_items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": { "type": "string" },
                  "owner": { "type": "string" },
                  "priority": { "type": "string" },
                  "due_date": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
