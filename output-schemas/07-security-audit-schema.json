{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infrastructure Security Audit Output",
  "description": "Structured output schema for infrastructure security audit reports",
  "type": "object",
  "required": ["executive_summary", "findings"],
  "properties": {
    "executive_summary": {
      "type": "object",
      "required": ["finding_counts", "overall_risk"],
      "properties": {
        "scope": { "type": "string", "description": "What was audited" },
        "finding_counts": {
          "type": "object",
          "required": ["critical", "high", "medium", "low"],
          "properties": {
            "critical": { "type": "integer" },
            "high": { "type": "integer" },
            "medium": { "type": "integer" },
            "low": { "type": "integer" },
            "informational": { "type": "integer" }
          }
        },
        "overall_risk": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MODERATE", "LOW"],
          "description": "Overall risk posture assessment"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "category", "description", "attack_scenario", "remediation"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FINDING-[0-9]{3}$",
            "description": "Unique finding identifier"
          },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]
          },
          "category": {
            "type": "string",
            "enum": ["IAM", "Network", "Encryption", "Logging", "Container", "CI-CD", "Supply-Chain", "Data", "Configuration"],
            "description": "Security domain"
          },
          "affected_resource": { "type": "string" },
          "cis_reference": { "type": "string", "description": "CIS Benchmark or NIST control reference" },
          "description": { "type": "string" },
          "attack_scenario": { "type": "string", "description": "Step-by-step exploitation path" },
          "current_configuration": { "type": "string", "description": "The problematic configuration" },
          "remediation": {
            "type": "object",
            "required": ["description", "corrected_configuration"],
            "properties": {
              "description": { "type": "string" },
              "corrected_configuration": { "type": "string" },
              "steps": {
                "type": "array",
                "items": { "type": "string" }
              },
              "estimated_effort": { "type": "string" }
            }
          },
          "verification": {
            "type": "object",
            "properties": {
              "command": { "type": "string", "description": "Command to verify the fix" },
              "expected_result": { "type": "string" }
            }
          }
        }
      }
    },
    "compliance_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "framework": { "type": "string", "description": "e.g., CIS AWS 2.0, SOC 2, HIPAA" },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "control_id": { "type": "string" },
                "control_name": { "type": "string" },
                "status": { "type": "string", "enum": ["PASS", "FAIL", "N/A"] },
                "finding_reference": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "security_roadmap": {
      "type": "object",
      "properties": {
        "immediate": {
          "type": "array",
          "items": { "type": "string" },
          "description": "24-48 hour actions"
        },
        "short_term": {
          "type": "array",
          "items": { "type": "string" },
          "description": "1-2 week actions"
        },
        "medium_term": {
          "type": "array",
          "items": { "type": "string" },
          "description": "1-3 month actions"
        },
        "ongoing": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Continuous security practices"
        }
      }
    }
  }
}
