{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CI/CD Pipeline Designer Output",
  "description": "Structured output schema for CI/CD pipeline design responses",
  "type": "object",
  "required": ["pipeline_overview", "workflows"],
  "properties": {
    "pipeline_overview": {
      "type": "object",
      "required": ["description", "stages", "ci_platform"],
      "properties": {
        "description": { "type": "string" },
        "ci_platform": {
          "type": "string",
          "enum": ["github-actions", "gitlab-ci", "circleci", "jenkins", "azure-devops"]
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "purpose", "trigger"],
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "trigger": { "type": "string" },
              "estimated_duration": { "type": "string" }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "content", "purpose"],
        "properties": {
          "filename": { "type": "string", "description": "e.g., .github/workflows/ci.yml" },
          "content": { "type": "string", "description": "Complete workflow YAML content" },
          "purpose": { "type": "string" },
          "triggers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Events that trigger this workflow"
          }
        }
      }
    },
    "required_configuration": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "how_to_obtain": { "type": "string" }
            }
          }
        },
        "environment_variables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "default_value": { "type": "string" }
            }
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "protection_rules": {
                "type": "array",
                "items": { "type": "string" }
              },
              "required_reviewers": { "type": "integer" }
            }
          }
        }
      }
    },
    "optimization": {
      "type": "object",
      "properties": {
        "caching_strategy": { "type": "string" },
        "parallelization": { "type": "string" },
        "estimated_run_times": {
          "type": "object",
          "properties": {
            "pr_pipeline": { "type": "string" },
            "deploy_pipeline": { "type": "string" }
          }
        },
        "cost_notes": { "type": "string" }
      }
    }
  }
}
